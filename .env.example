# Local development only. Relative paths resolve from prisma/ as before.
DATABASE_URL="file:../data/blog.db"

# Hosting: use a separate Turso database for preview and production.
# Keep these server-only; do not prefix with NEXT_PUBLIC_.
# TURSO_DATABASE_URL="libsql://your-database.turso.io"
# TURSO_AUTH_TOKEN="your-token"

# Local timezone used to compute "today" for streaks and learning-log dates.
# IANA timezone name, e.g. "Asia/Shanghai", "America/New_York".
SITE_TIMEZONE="Asia/Ho_Chi_Minh"

# Studio (private /studio workspace) authentication — see docs/OPERATIONS.md#studio-authentication.
# STUDIO_PASSWORD is the single owner password; STUDIO_SESSION_SECRET signs the session cookie.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDIO_PASSWORD="change-me"
STUDIO_SESSION_SECRET="change-me-too-a-long-random-string"
